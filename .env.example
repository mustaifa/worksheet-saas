# --- Database (Postgres). Free options: neon.tech, supabase.com, railway.app ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- NextAuth ---
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe ---
# From https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# From https://dashboard.stripe.com/webhooks after creating an endpoint
STRIPE_WEBHOOK_SECRET="whsec_..."
# Create two recurring Prices in the Stripe Dashboard (Product catalog) and paste their IDs:
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_YEARLY="price_..."

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TRIAL_DAYS="7"

# --- Email (Resend — free tier at resend.com) ---
RESEND_API_KEY="re_..."
EMAIL_FROM="Practice Sheet <onboarding@resend.dev>"

# --- Cron security ---
# Any random string. Set the SAME value here and in Vercel env vars.
# Vercel Cron automatically sends it as a Bearer token, so only Vercel's own
# scheduled job can trigger /api/cron/trial-emails.
CRON_SECRET="replace-with-a-random-string"

# --- Homework Tutor Chat (Anthropic API) ---
# Get a key at https://console.anthropic.com — this is a PAID API, unlike
# the worksheet generator. Set a spending limit in the Anthropic console.
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
# Max tutor messages per user per day — caps your API cost exposure.
CHAT_DAILY_LIMIT="25"
