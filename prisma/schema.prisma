generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  passwordHash         String
  createdAt            DateTime  @default(now())
  role                 String    @default("user") // user | admin

  // Trial + subscription state
  trialEndsAt          DateTime
  subscriptionStatus   String    @default("trialing") // trialing | active | past_due | canceled
  subscriptionPlan     String?   // monthly | yearly
  currentPeriodEnd     DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique

  // Email lifecycle tracking (prevents duplicate sends from the daily cron)
  welcomeEmailSentAt     DateTime?
  trialReminderSentAt    DateTime? // "2 days left" email
  trialEndedEmailSentAt  DateTime? // "trial has ended" email
}
