generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  passwordHash         String
  createdAt            DateTime  @default(now())
  role                 String    @default("user") // user | admin
  
  worksheetScansUsedToday    Int      @default(0)
  worksheetScanUsageResetAt  DateTime @default(now())

  // Trial + subscription state
  trialEndsAt          DateTime
  subscriptionStatus   String    @default("trialing") // trialing | active | past_due | canceled
  subscriptionPlan     String?   // monthly | yearly
  currentPeriodEnd     DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique

  // Email lifecycle tracking (prevents duplicate sends from the daily cron)
  welcomeEmailSentAt     DateTime?
  trialReminderSentAt    DateTime? // "2 days left" email
  trialEndedEmailSentAt  DateTime? // "trial has ended" email

  // Tutor chat usage (resets daily, caps API cost exposure per user)
  chatMessagesUsedToday  Int       @default(0)
  chatUsageResetAt       DateTime  @default(now())

  children               ChildProfile[]
  liveSessions           LiveSession[]
  whiteboards            Whiteboard[]
  customWorksheets       CustomWorksheet[]
  scannedWorksheets ScannedWorksheet[]
}

model ChildProfile {
  id           String   @id @default(cuid())
  parentId     String
  name         String
  avatar       String   @default("🧒")
  pin          String?  // optional 4-digit PIN, just to prevent siblings mixing up profiles on a shared device — not real auth
  gradeDefault Int      @default(3)
  createdAt    DateTime @default(now())

  parent       User               @relation(fields: [parentId], references: [id], onDelete: Cascade)
  rewardItems  RewardItem[]
  attempts     ChallengeAttempt[]
  claims       RewardClaim[]

  @@index([parentId])
}

model RewardItem {
  id         String   @id @default(cuid())
  childId    String
  difficulty String   // easy | medium | hard
  label      String   // e.g. "$5", "Roblox gift card", "Choose dinner tonight"
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  child      ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
}

model ChallengeAttempt {
  id          String    @id @default(cuid())
  childId     String
  subject     String
  grade       Int
  topic       String
  difficulty  String
  seed        Int
  count       Int
  status      String    @default("in_progress") // in_progress | completed
  score       Int?
  passed      Boolean?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  claim       RewardClaim?

  @@index([childId])
}

model RewardClaim {
  id          String    @id @default(cuid())
  childId     String
  attemptId   String    @unique
  prizeLabel  String
  status      String    @default("pending") // pending | fulfilled
  createdAt   DateTime  @default(now())
  fulfilledAt DateTime?

  child       ChildProfile     @relation(fields: [childId], references: [id], onDelete: Cascade)
  attempt     ChallengeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([childId])
}

model LiveSession {
  id            String    @id @default(cuid())
  hostUserId    String
  code          String    @unique
  subject       String
  grade         Int
  topic         String
  difficulty    String
  seed          Int
  questionCount Int
  status        String    @default("lobby") // lobby | active | finished
  currentIndex  Int       @default(0)
  showAnswer    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  endedAt       DateTime?

  host          User              @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  participants  LiveParticipant[]

  @@index([hostUserId])
}

model LiveParticipant {
  id         String   @id @default(cuid())
  sessionId  String
  nickname   String
  score      Int      @default(0)
  joinedAt   DateTime @default(now())

  session    LiveSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers    LiveAnswer[]

  @@index([sessionId])
}

model LiveAnswer {
  id            String   @id @default(cuid())
  participantId String
  questionIndex Int
  submitted     String
  correct       Boolean
  createdAt     DateTime @default(now())

  participant   LiveParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, questionIndex])
  @@index([participantId])
}

model Whiteboard {
  id            String    @id @default(cuid())
  hostUserId    String
  code          String    @unique
  title         String?
  snapshot      String?   @db.Text // base64 PNG data URL of the current board
  activeDrawerId String?  // WhiteboardViewer.id currently granted drawing permission, or null (host-only)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  host          User                @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  viewers       WhiteboardViewer[]

  @@index([hostUserId])
}

model WhiteboardViewer {
  id           String   @id @default(cuid())
  whiteboardId String
  nickname     String
  joinedAt     DateTime @default(now())

  whiteboard   Whiteboard @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)

  @@index([whiteboardId])
}

model CustomWorksheet {
  id         String   @id @default(cuid())
  hostUserId String
  title      String
  subject    String?  // "math" | "english" | "science" | null (mixed/other)
  grade      Int?
  shareCode  String   @unique
  pages      Json     // array of { id: string, snapshot: string | null } — each page is a base64 PNG
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  host       User @relation(fields: [hostUserId], references: [id], onDelete: Cascade)

  @@index([hostUserId])
}
